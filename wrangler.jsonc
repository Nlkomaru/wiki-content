{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "wiki-v2-content",
    "compatibility_date": "2025-05-20",
    // 配信ドメイン。独自ドメインを正とし、workers.dev も移行期間として残す
    "workers_dev": true,
    "routes": [
        {
            "pattern": "wiki-content.moripa.nikomaru.dev",
            "custom_domain": true
        }
    ],
    "main": "src/index.ts",
    "assets": {
        "directory": "./content",
        "binding": "ASSETS",
        // draft 遮断が必要な記事パスだけ worker を通す。manifest / カテゴリは
        // 従来どおり asset-first で配信する。
        "run_worker_first": ["/article/*"]
    }
}
